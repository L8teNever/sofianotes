# Lokal: einfach unveraendert lassen (Default 127.0.0.1:8000).
# Fuer den produktiven Betrieb hinter einem eigenen Reverse Proxy/Tunnel:
# als .env (nicht eingecheckt) neben docker-compose.yml anlegen und
# BIND_HOST/BIND_PORT auf das setzen, was die eigene Infrastruktur erwartet.
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Optional: Cloudflare Workers AI (Moondream) for messy handwriting.
# Ohne Token bleibt nur die lokale EMNIST-Erkennung.
# Tageslimit = Free-Kontingent 10.000 Neuronen (UTC), danach keine KI-Calls mehr.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_OCR_MODEL=@cf/moondream/moondream3.1-9B-A2B
# OCR_DAILY_NEURONS=10000
# OCR_NEURONS_PER_CALL=80
