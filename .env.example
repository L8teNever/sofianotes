# Lokal: einfach unveraendert lassen (Default 127.0.0.1:8000).
# Fuer den produktiven Betrieb hinter einem eigenen Reverse Proxy/Tunnel:
# als .env (nicht eingecheckt) neben docker-compose.yml anlegen und
# BIND_HOST/BIND_PORT auf das setzen, was die eigene Infrastruktur erwartet.
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Mail-Adresse, die beim allerersten Start automatisch als Admin angelegt
# wird (kann sich danach ueber Cloudflare Access einloggen und weitere
# Nutzer + deren Mail-Adressen anlegen). Ohne Cloudflare Access davor kann
# sich NIEMAND einloggen, egal was hier steht -- siehe README.
ADMIN_EMAIL=admin@example.com

# NUR fuer lokale Entwicklung ohne Cloudflare Access: taeuscht die genannte
# Mail-Adresse als eingeloggten Nutzer vor. Im produktiven Betrieb (hinter
# Cloudflare Access) NIE setzen -- das waere ein kompletter Auth-Bypass.
#DEV_BYPASS_EMAIL=admin@example.com
