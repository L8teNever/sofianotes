#!/bin/sh
# Bei jedem Commit die App-Version (Patch) hochzaehlen.
root="$(git rev-parse --show-toplevel)"
if [ -d "$root/.git/rebase-merge" ] || [ -d "$root/.git/rebase-apply" ] || [ -f "$root/.git/MERGE_HEAD" ]; then
  exit 0
fi
python3 "$root/scripts/bump-version.py" || exit 1
git add "$root/backend/version.json"
exit 0
